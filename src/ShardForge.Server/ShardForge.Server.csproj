<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shardforge-server</AssemblyName>
    <RootNamespace>ShardForge.Server</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShardForge.Core\ShardForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <!-- Web pages are embedded so the server is a single self-contained program. -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\editor\index.html" LogicalName="web/editor/index.html" />
    <EmbeddedResource Include="..\..\walk\index.html" LogicalName="web/walk/index.html" />
  </ItemGroup>

</Project>
